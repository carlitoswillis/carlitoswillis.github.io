---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import resume from '../data/resume.public.json';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const secondary = [
  {
    name: 'OP-1 Lab',
    tech: 'Blackfin assembly, Python, GNU bfin toolchain, op1repacker',
    blurb:
      'Mapping the closed Blackfin firmware of the original OP-1 synthesizer to see how it works, then writing an oscillator in assembly that runs on the hardware itself — every modification byte-verified before flashing, so the stock firmware can always be restored. The firmware work stays in a private repo; the write-up is the public artifact.',
    links: [{ label: 'write-up', href: '/projects/op1-lab/' }],
  },
  {
    name: 'armak.tech',
    tech: 'Vite, EJS, Vanilla JS, HTML Canvas',
    blurb:
      'Live production website for a Southern California low-voltage & networking firm. A static Vite + EJS build with hand-written Canvas animations — a mouse-reactive particle network and an animated SVG service-area map — lazy-loaded per viewport, a backend-less contact form, and WebP hero images that load early.',
    links: [{ label: 'live site', href: 'https://armak.tech' }],
  },
  {
    name: 'Incighder',
    tech: 'Next.js, TypeScript, Python, MySQL, Gemini 2.5 Flash',
    blurb:
      'Artist-scouting tool built around one question that turned out to be the hard part: are these accounts actually the same artist? Search-backed discovery finds candidate profiles, Gemini verifies the ambiguous ones, and patient scraping (24-hour caches, jittered backoff) turns six platforms’ metrics into growth history and one traction score.',
    links: [
      { label: 'live site', href: 'https://incighder.vercel.app' },
      { label: 'write-up', href: '/projects/incighder/' },
      { label: 'repo', href: 'https://github.com/carlitoswillis/incighder' },
    ],
  },
  {
    name: 'Beatpack',
    tech: 'Electron, React, Node.js, ffmpeg',
    blurb:
      'Started as scripts for my own music workflow, grew into a desktop app that automates the release grind for beat producers: stem zipping, MP3 encoding, cover-art overlay, and ffmpeg-driven video assembly. Dropping in a folder does the export work I used to do by hand.',
    links: [{ label: 'repo', href: 'https://github.com/carlitoswillis/beatpack' }],
  },
  {
    name: 'Expert',
    tech: 'React, Node.js, Express, JSON store (MySQL optional), WASM OCR',
    blurb:
      'Personal-knowledge tool that makes everything you’ve read searchable by content: image-only scans are detected and run through a background WASM OCR pipeline, so even text-less PDFs join one searchable collection. Searching across sources is the next piece.',
    links: [{ label: 'repo', href: 'https://github.com/carlitoswillis/expert' }],
  },
  {
    name: 'Ezzy Shop',
    tech: 'AWS EC2, Nginx, Redis, PostgreSQL, Node.js, Express, React, Docker',
    blurb:
      'Chased bottlenecks through the whole stack of an e-commerce product service — application, database schema, and infrastructure — with every change measured under load (K6, Loader.io).',
    metrics: [
      { value: '200 → 800', unit: 'req/s' },
      { value: '230 → 70', unit: 'ms' },
    ],
    links: [],
  },
  {
    name: 'Portboard',
    tech: 'Node.js (zero dependencies)',
    blurb:
      'A single-file dashboard that lists a Mac’s listening ports as tappable links, so a phone on the same network or tailnet can jump straight into a local dev server. LAN-only, no hosted demo.',
    links: [{ label: 'repo', href: 'https://github.com/carlitoswillis/portboard' }],
  },
  {
    name: 'Delegate',
    tech: 'Shell, Python',
    blurb:
      'A shell wrapper that hands a task to another model and keeps one readable transcript per run, with a terminal and web viewer for browsing runs and watching them live.',
    links: [{ label: 'repo', href: 'https://github.com/carlitoswillis/delegate' }],
  },
  {
    name: 'Termdeck',
    tech: 'Python, iTerm2 Python API',
    blurb:
      'Mirrors iTerm2 sessions to a phone over Tailscale: read scrollback, type into a session, and share one read-only with a link.',
    links: [{ label: 'repo', href: 'https://github.com/carlitoswillis/Termdeck' }],
  },
  {
    name: 'Deckhand',
    tech: 'Node.js',
    blurb:
      'Read-only collectors snapshot a Mac into files, with a small web UI and a local-model question box over the snapshot.',
    links: [{ label: 'repo', href: 'https://github.com/carlitoswillis/deckhand' }],
  },
];

/* The hero's measured fact is counted from the record itself, never asserted. */
const entries = projects.length + secondary.length;
const withSource =
  projects.filter((p) => p.data.repo).length +
  secondary.filter((s) => s.links.some((l) => l.label === 'repo')).length;
const openNow =
  projects.filter((p) => p.data.demo).length +
  secondary.filter((s) => s.links.some((l) => l.label === 'live site')).length;

const pad = (n: number) => String(n).padStart(2, '0');

/* Portrait screenshots sit at text measure; landscape stills fill the full
   evidence width. The shape of the picture decides, not a fixed cap. */
const isPortrait = (g: { width: number; height: number }[]) =>
  g.every((x) => x.height > x.width);
---

<Base
  title="Carlitos Willis — Software Engineer"
  description="Software engineer in Los Angeles. Projects that start with a question worth chasing — event sourcing, reverse-engineered synthesizer firmware, developer tools for music — each with working software, source code, or a technical write-up."
>
  <!-- ========== HERO: one sentence, one measured fact ========== -->
  <section class="wrap">
    <div class="row pt-14 pb-16 sm:pt-20 sm:pb-24">
      <p class="idx hidden lg:block lg:self-end" aria-hidden="true">00</p>
      <div>
        <p class="mono small prompt text-steel">
          <span class="text-signal">$</span> currently: rewinding a task board, indexing a decade
          of Ableton sessions, building an audio analysis plugin
        </p>
        <p class="mono mt-4 text-steel uppercase">{[resume.title, resume.contact?.location].filter(Boolean).join(' \u00b7 ')}</p>
        <h1 class="display mt-5">I build systems that show their work.</h1>

        <div class="measure mt-10">
          <p class="lede">
            Most of my projects start with a question I can't let go. Lately that's led me to
            event sourcing, reverse-engineering an old synthesizer, and building developer tools
            for my own music workflow. Every project here includes working software, source code,
            or a write-up of how it works.
          </p>
          <p class="small measure-small mt-5 text-steel">
            Before that I did full-stack growth engineering at{' '}
            <span class="font-semibold text-ink">Gusto</span>: nine A/B tests in six months, one
            of which moved visit-to-lead conversion by <span class="fig">15.5%</span>.
          </p>
        </div>

        <div class="actions mt-8">
          <a href="#record" class="link">projects</a>
          <a href="/resume/" class="link" target="_blank" rel="noopener noreferrer">resume</a>
          <a
            href="https://github.com/carlitoswillis"
            class="link"
            target="_blank"
            rel="noopener noreferrer">github</a
          >
          <a
            href="https://linkedin.com/in/carlitoswillis"
            class="link"
            target="_blank"
            rel="noopener noreferrer">linkedin</a
          >
          <a href="mailto:carlitoswillis@berkeley.edu" class="link">email</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== THE RECORD: the spine starts here ========== -->
  <section id="record" class="wrap spine" aria-labelledby="record-h">
    <!-- section head sits on the spine's first row -->
    <div class="row border-t border-rule pt-4 pb-8">
      <p class="idx" aria-hidden="true">&nbsp;</p>
      <div class="col flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
        <h2 id="record-h" class="eyebrow"><span id="projects"></span>The record</h2>
        <p class="mono text-steel uppercase">
          {pad(entries)} entries &middot; {pad(withSource)} with public source &middot; {
            pad(openNow)
          } running now
        </p>
      </div>
    </div>

    {
      projects.map((p, i) => (
        <article class="row border-t border-rule pt-6 pb-20">
          <!-- RAIL: index, status, domain — every fact in mono -->
          <div class="pb-4 lg:pb-0">
            <p class="idx" aria-hidden="true">{pad(i + 1)}</p>
            <div class="mono mt-2 flex flex-wrap gap-x-4 lg:mt-6 lg:block lg:space-y-2">
              <p class="font-medium text-ink uppercase">
                {p.data.status}
                {p.data.live && <span class="dot-live ml-1.5 align-middle" />}
              </p>
              {p.data.domain.split('·').map((d) => (
                <p class="text-steel uppercase">{d.trim()}</p>
              ))}
            </div>
          </div>

          <div class="col">
            <h3 class="title">
              <a href={`/projects/${p.id}/`} class="title-link">
                {p.data.title}
              </a>
            </h3>
            <p class="mono mt-3 text-steel">
              {p.data.demo ? (
                <a href={p.data.demo} class="link" target="_blank" rel="noopener noreferrer">
                  {p.data.statusDetail}
                </a>
              ) : (
                p.data.statusDetail
              )}
              {' · '}
              {p.data.stack.join(' · ')}
            </p>

            {/* EVIDENCE — wider than its own description, on purpose */}
            {p.data.video && (
              <video
                class="evidence mt-8"
                controls
                autoplay={!p.data.videoControls || undefined}
                muted={!p.data.videoControls || undefined}
                loop={!p.data.videoControls || undefined}
                playsinline
                preload="metadata"
                poster={p.data.poster}
                src={p.data.video}
                aria-label={p.data.videoAlt}
              />
            )}
            {p.data.gallery && (
              <div
                class:list={[
                  'mt-8 grid grid-cols-1 gap-5 md:grid-cols-2',
                  isPortrait(p.data.gallery) && 'measure',
                ]}
              >
                {p.data.gallery.map((g) => (
                  <img
                    src={g.src}
                    alt={g.alt}
                    width={g.width}
                    height={g.height}
                    loading="lazy"
                    decoding="async"
                    class="evidence"
                  />
                ))}
              </div>
            )}
            {p.data.galleryCaption && <p class="caption mt-3">{p.data.galleryCaption}</p>}

            <p class="measure mt-8">{p.data.summary}</p>

            <div class="actions mt-6">
              {p.data.demo && (
                <a href={p.data.demo} class="link" target="_blank" rel="noopener noreferrer">
                  live demo
                </a>
              )}
              <a href={`/projects/${p.id}/`} class="link">
                case study
              </a>
              {p.data.repo && (
                <a href={p.data.repo} class="link" target="_blank" rel="noopener noreferrer">
                  repo
                </a>
              )}
            </div>
          </div>
        </article>
      ))
    }

    <!-- ========== THE LEDGER: same spine, different density ========== -->
    <div class="row border-t border-rule pt-4 pb-8">
      <p class="idx" aria-hidden="true">&nbsp;</p>
      <div class="col">
        <h2 class="eyebrow">Other projects</h2>
      </div>
    </div>

    {
      secondary.map((s, i) => (
        <div class="row border-t border-line py-6">
          <div class="pb-2 lg:pb-0">
            <p class="idx" aria-hidden="true">{pad(projects.length + i + 1)}</p>
          </div>
          <div class="col">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <h3 class="section-h">{s.name}</h3>
              {s.metrics &&
                s.metrics.map((m) => (
                  <p class="mono">
                    <span class="fig">{m.value}</span>{' '}
                    <span class="text-steel">{m.unit}</span>
                  </p>
                ))}
            </div>
            <p class="mono mt-2 text-steel">{s.tech}</p>
            <p class="small measure mt-3 text-steel">{s.blurb}</p>
            <div class="actions mt-4">
              {s.links.length ? (
                s.links.map((l) => (
                  <a
                    href={l.href}
                    class="link"
                    target={l.href.startsWith('http') ? '_blank' : undefined}
                    rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {l.label}
                  </a>
                ))
              ) : (
                <span class="text-steel">write-up on request</span>
              )}
            </div>
          </div>
        </div>
      ))
    }
  </section>
</Base>
