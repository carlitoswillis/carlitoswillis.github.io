---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const index = String(d.order).padStart(2, '0');
const hasLinks = Boolean(d.demo || d.repo);
const portraitGallery = d.gallery?.every((g) => g.height > g.width) ?? false;
---

<Base title={`${d.title} — Carlitos Willis`} description={d.summary}>
  <article class="wrap spine">
    <!-- ========== HEAD: the entry's own readout ========== -->
    <div class="row pt-10 pb-6">
      <p class="idx" aria-hidden="true">{index}</p>
      <div>
        <a href="/#record" class="actions"><span class="link">&larr; the record</span></a>
        <h1 class="display mt-5">{d.title}</h1>
      </div>
    </div>

    <div class="row border-t border-rule pt-6 pb-16">
      <!-- RAIL: status, domain, stack, links — the whole spec column -->
      <aside class="rail-sticky pb-6 lg:pb-0" aria-label="Specifications">
        <div class="mono flex flex-wrap gap-x-4 gap-y-1 lg:block lg:space-y-2">
          <p class="font-medium text-ink uppercase">
            {d.status}
            {d.live && <span class="dot-live ml-1.5 align-middle" />}
          </p>
          {d.domain.split('·').map((part) => <p class="text-steel uppercase">{part.trim()}</p>)}
        </div>
        <div class="mono mt-4 space-y-1 border-t border-line pt-4 text-steel lg:mt-6 lg:pt-5">
          {d.stack.map((s) => <p>{s}</p>)}
        </div>
        {hasLinks && (
          <div class="actions mt-5 border-t border-line pt-4 lg:mt-6 lg:flex-col lg:gap-2 lg:pt-5">
            {d.demo && (
              <a href={d.demo} class="link" target="_blank" rel="noopener noreferrer">
                live demo
              </a>
            )}
            {d.repo && (
              <a href={d.repo} class="link" target="_blank" rel="noopener noreferrer">
                repo
              </a>
            )}
          </div>
        )}
      </aside>

      <div class="col">
        <p class="lede measure">{d.summary}</p>

        {/* EVIDENCE first — it is the argument, the prose is the footnote */}
        {
          d.video && (
            <figure class="mt-10">
              <video
                class="evidence"
                controls
                autoplay={!d.videoControls || undefined}
                muted={!d.videoControls || undefined}
                loop={!d.videoControls || undefined}
                playsinline
                preload="metadata"
                poster={d.poster}
                src={d.video}
                aria-label={d.videoAlt}
              />
              {!d.videoControls && (
                <figcaption class="caption mt-3">
                  The live demo, rewound: dragging the scrubber re-renders the board as it was.
                </figcaption>
              )}
            </figure>
          )
        }

        {
          d.gallery && (
            <figure class="mt-10">
              <div class:list={['grid grid-cols-1 gap-5 md:grid-cols-2', portraitGallery && 'measure']}>
                {d.gallery.map((g) => (
                  <img
                    src={g.src}
                    alt={g.alt}
                    width={g.width}
                    height={g.height}
                    loading="lazy"
                    decoding="async"
                    class="evidence"
                  />
                ))}
              </div>
              {d.galleryCaption && <figcaption class="caption mt-3">{d.galleryCaption}</figcaption>}
            </figure>
          )
        }

        <div class="copy mt-16">
          <Content />
        </div>
      </div>
    </div>
  </article>
</Base>
