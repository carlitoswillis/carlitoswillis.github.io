---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
// One source of truth: ../autojob/profile/resume.json, published here by
// `npm run site:sync` in that repo as src/data/resume.public.json (phone
// stripped — this site is email-only) and public/carlitos-willis-resume.pdf
// (the generated PDF itself). Edit the résumé there, then re-run the sync.
import resume from '../data/resume.public.json';

const c = resume.contact || {};
const shortUrl = (u) => u.replace(/^(https?:)?\/\//i, '').replace(/\/$/, '');
const fullUrl = (u) => (/^(https?:)?\/\//i.test(u) ? u : `https://${u}`);
const links = [
  c.email ? { label: c.email, href: `mailto:${c.email}`, external: false } : null,
  c.github ? { label: shortUrl(c.github), href: fullUrl(c.github), external: true } : null,
  c.linkedin ? { label: shortUrl(c.linkedin), href: fullUrl(c.linkedin), external: true } : null,
].filter(Boolean);

// A project with a case study on this site links there; otherwise to its own
// live site or repo, as the résumé does.
const studies = new Map((await getCollection('projects')).map((p) => [p.data.title.toLowerCase(), `/projects/${p.id}/`]));
const projects = resume.projects.map((p) => {
  const study = studies.get(p.name.toLowerCase());
  return { ...p, href: study ?? (p.link ? fullUrl(p.link) : null), internal: Boolean(study) };
});
// A role with a write-up on this site gets a link under its bullets, keyed by
// org here so the synced résumé data stays untouched.
const roleStudies = { gusto: { label: 'Growth experiments write-up', href: '/projects/experiments/' } };
const { skills, experience, education, competencies = [], title } = resume;
const subtitle = [title, c.location].filter(Boolean).join(' \u00b7 ');
---

<Base
  title="Resume — Carlitos Willis"
  description="Resume of Carlitos Willis, software engineer in Los Angeles: full-stack growth engineering at Gusto, independent consulting, and systems projects in TypeScript and Rust."
>
  <div class="wrap spine">
    <!-- ========== MASTHEAD ========== -->
    <header class="row pt-10 pb-8">
      <p class="idx" aria-hidden="true">CV</p>
      <div>
        <h1 class="display">{resume.name}</h1>
        <p class="mono mt-4 text-steel uppercase">{subtitle}</p>
        <div class="actions mt-5">
          {links.map((l) => (
            l.external
              ? <a href={l.href} class="link" target="_blank" rel="noopener noreferrer">{l.label}</a>
              : <a href={l.href} class="link">{l.label}</a>
          ))}
          <a href="/carlitos-willis-resume.pdf" class="link no-print" target="_blank" rel="noopener noreferrer">download PDF</a>
        </div>
      </div>
    </header>

    <!-- ========== SKILLS ========== -->
    <section class="row border-t border-rule pt-5 pb-10" aria-labelledby="r-skills">
      <h2 id="r-skills" class="eyebrow rail-sticky lg:pt-1">Skills</h2>
      <dl class="col small measure-small space-y-2">
        {competencies.length > 0 && (
          <div>
            <dt class="mono inline text-steel uppercase">Competencies</dt>
            <dd class="inline">&nbsp;&nbsp;{competencies.join(' \u00b7 ')}</dd>
          </div>
        )}
        {
          skills.map((s) => (
            <div>
              <dt class="mono inline text-steel uppercase">{s.label}</dt>
              <dd class="inline">&nbsp;&nbsp;{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ========== EXPERIENCE ========== -->
    <section class="row border-t border-rule pt-5 pb-10" aria-labelledby="r-exp">
      <h2 id="r-exp" class="eyebrow rail-sticky lg:pt-1">Experience</h2>
      <div class="col space-y-9">
        {
          experience.map((e) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h3 class="section-h measure-small">
                  {e.title}
                  {e.org && <span class="font-medium text-steel"> &mdash; {e.org}</span>}
                </h3>
                <p class="mono whitespace-nowrap text-steel uppercase">{e.dates}</p>
              </div>
              <p class="mono mt-1 text-steel uppercase">{e.location}</p>
              <ul class="small measure-small mt-3 space-y-2">
                {e.bullets.map((b) => (
                  <li class="relative pl-6 before:absolute before:left-0 before:text-rule before:content-['\2014']">
                    {b}
                  </li>
                ))}
              </ul>
              {roleStudies[e.org?.toLowerCase()] && (
                <p class="no-print small mt-3 pl-6">
                  <a href={roleStudies[e.org.toLowerCase()].href} class="link">
                    {roleStudies[e.org.toLowerCase()].label}
                  </a>
                </p>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <!-- ========== PROJECTS ========== -->
    <section class="row border-t border-rule pt-5 pb-10" aria-labelledby="r-proj">
      <h2 id="r-proj" class="eyebrow rail-sticky lg:pt-1">Projects</h2>
      <div class="col space-y-8">
        {
          projects.map((p) => (
            <div>
              <h3 class="section-h measure-small">
                {p.href ? (
                  !p.internal ? (
                    <a href={p.href} class="link" target="_blank" rel="noopener noreferrer">
                      {p.name}
                    </a>
                  ) : (
                    <a href={p.href} class="title-link">
                      {p.name}
                    </a>
                  )
                ) : (
                  p.name
                )}
                <span class="font-medium text-steel"> &mdash; {p.detail}</span>
              </h3>
              <p class="mono mt-1 text-steel">{p.tech}</p>
              <ul class="small measure-small mt-3 space-y-2">
                {p.bullets.map((b) => (
                  <li class="relative pl-6 before:absolute before:left-0 before:text-rule before:content-['\2014']">
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ========== EDUCATION ========== -->
    <section class="row border-t border-rule pt-5 pb-10" aria-labelledby="r-edu">
      <h2 id="r-edu" class="eyebrow rail-sticky lg:pt-1">Education</h2>
      <ul class="col small space-y-2">
        {
          education.map((ed) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-6">
              <span>
                <span class="font-semibold">{ed.school}</span>
                <span class="text-steel"> &mdash; {ed.detail}</span>
              </span>
              <span class="mono text-steel">{ed.year}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>
